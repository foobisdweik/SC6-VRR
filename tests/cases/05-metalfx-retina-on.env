# MetalFX 2x on with Retina mode on. Expected: the game renders at the full
# 3456x2234 and MetalFX tries to output twice that. Confirms why 02 needs Retina off.
# Native fullscreen is pinned off so results stay comparable with the first runs.
DESCRIPTION="MetalFX 2x on, Retina on (expected to overshoot)"
LAUNCH=bundle
RETINA_SC6=y
GAMEMODE=auto
TEST_ENV=( "DXMT_CONFIG=dxgi.nativeFullscreen=False;" )
