# Frame-cap DLL test (dinput8 proxy in Binaries/Win64). The full SC6 DXMT
# profile applies. The unlock now always keeps world logic at 60 Hz.
DESCRIPTION="Full profile + DLL uncap: expect up to 120 fps and normal fight speed"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" )
