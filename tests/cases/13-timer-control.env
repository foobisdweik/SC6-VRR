# Compare with 11 to check the effect of the four added CPU timers.
DESCRIPTION="As 11, but with frame-breakdown hooks disabled; control for timer overhead"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
THREAD_METRICS=1
METAL_TRACE=1
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "SC6VRR_FRAME_TIMERS=0" "DXMT_LOG_FRAME_STATS=1" "METAL_PERFORMANCE_PER_FRAME_SIGNPOSTS=1" "MTL_HUD_ENCODER_TIMING_ENABLED=0" )
