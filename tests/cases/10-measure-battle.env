# Measure elapsed time and completed battle work without macOS sample.
DESCRIPTION="As 08, with completed battle counters, world timing, and DXMT frame statistics; no CPU sampling"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
TEST_ENV=( "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "DXMT_LOG_FRAME_STATS=1" )
