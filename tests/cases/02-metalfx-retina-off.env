# The SC6 profile as shipped: MetalFX 2x on. Retina mode off for SC6 only, so
# the game should render at 1728x1117 and MetalFX should output 3456x2234.
# Native fullscreen is pinned off so results stay comparable with the first runs.
DESCRIPTION="MetalFX 2x on, Retina off for SC6"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=auto
TEST_ENV=( "DXMT_CONFIG=dxgi.nativeFullscreen=False;" )
