# Pass legacy game thread names to macOS, then inspect thread CPU use.
DESCRIPTION="DXMT idle thread names; no stack sampling"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
THREAD_METRICS=1
METAL_TRACE=0
GRAPHICS_BACKEND=dxmt
CLEAR_SC6_CACHES=0
PLAY_INSTRUCTION="Leave Geralt and Groh idle on Kaer Morhen. This run identifies the busy thread."
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "SC6VRR_FRAME_TIMERS=0" "SC6VRR_THREAD_NAMES=1" "DXMT_LOG_FRAME_STATS=1" "METAL_PERFORMANCE_PER_FRAME_SIGNPOSTS=1" "MTL_HUD_ENCODER_TIMING_ENABLED=0" )
