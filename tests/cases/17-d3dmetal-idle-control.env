# Fourth run in the four-case idle comparison.
DESCRIPTION="D3DMetal; idle Kaer Morhen; four detail timers disabled"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
THREAD_METRICS=1
METAL_TRACE=1
GRAPHICS_BACKEND=d3dmetal
CLEAR_SC6_CACHES=0
PLAY_INSTRUCTION="Leave both fighters idle on Kaer Morhen. Keep the same positions and camera."
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "SC6VRR_FRAME_TIMERS=0" "DXMT_LOG_FRAME_STATS=1" "METAL_PERFORMANCE_PER_FRAME_SIGNPOSTS=1" "MTL_HUD_ENCODER_TIMING_ENABLED=0" )
