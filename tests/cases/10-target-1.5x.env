# As 08, but MetalFX upscales 1.5x instead of 2x: the game still renders
# 1728x1084, and MetalFX outputs about 2592x1626, which macOS then scales to the
# panel. Check the HUD: GPU time, and "Direct" or "Composited".
DESCRIPTION="As 08, MetalFX factor 1.5 (smaller target resolution)"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
TEST_ENV=( "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "DXMT_LOG_FRAME_STATS=1" "DXMT_CONFIG=d3d11.metalSpatialUpscaleFactor=1.5;" )
