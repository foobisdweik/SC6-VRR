# Frame-cap DLL test (dinput8 proxy in Binaries/Win64). The full SC6 DXMT
# profile applies. In Training, watch the fight speed: normal or too fast.
DESCRIPTION="Full profile + DLL uncap and fixed 60 Hz battle step: expect up to 120 fps at normal speed"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" )
