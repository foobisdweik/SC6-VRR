# Same as 02, plus displaySyncEnabled on the Metal layer. Look for tearing and
# compare frame pacing with 02.
# Native fullscreen is pinned off so results stay comparable with the first runs.
DESCRIPTION="As 02, plus Metal display sync"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=auto
TEST_ENV=( "DXMT_CONFIG=dxgi.metalDisplaySync=True;dxgi.nativeFullscreen=False;" )
