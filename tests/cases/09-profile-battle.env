# Profiling run with the full SC6 setup (as 08). In Training, stay in the fight
# for at least 60 seconds so several CPU samples land in battle. Note the Metal
# HUD's GPU time and frame interval during the fight.
DESCRIPTION="As 08, plus CPU samples and DXMT frame statistics"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=1
TEST_ENV=( "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "DXMT_LOG_FRAME_STATS=1" )
