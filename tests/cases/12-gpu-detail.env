# Compare with 11 in the same Training scene. Extra GPU timing can add overhead.
DESCRIPTION="As 11, with GPU timing for individual Metal encoders"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
THREAD_METRICS=1
METAL_TRACE=1
TEST_ENV=( "SC6VRR_FRAME_MODS=1" "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "SC6VRR_FRAME_TIMERS=1" "DXMT_LOG_FRAME_STATS=1" "METAL_PERFORMANCE_PER_FRAME_SIGNPOSTS=1" "MTL_HUD_ENCODER_TIMING_ENABLED=1" )
