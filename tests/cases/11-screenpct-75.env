# As 08, but UE4 renders the 3D scene at 75% (about 1296x813) and upscales it
# to 1728x1084 before MetalFX 2x. The HUD and menus stay at 1728x1084.
# Check the HUD GPU time and the fight's frame rate against 08.
DESCRIPTION="As 08, r.ScreenPercentage=75 (smaller internal render)"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
ENGINE_INI_SETTINGS=( "r.ScreenPercentage=75" "r.Upscale.Quality=3" )
TEST_ENV=( "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "DXMT_LOG_FRAME_STATS=1" )
