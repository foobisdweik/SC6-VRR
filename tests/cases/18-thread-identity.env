# Identify a busy thread. Do not use this run for frame-rate comparisons.
DESCRIPTION="DXMT idle thread identification with one Time Profiler capture"
LAUNCH=bundle
RETINA_SC6=n
GAMEMODE=on
PROFILE=0
THREAD_METRICS=1
METAL_TRACE=0
GRAPHICS_BACKEND=dxmt
CLEAR_SC6_CACHES=0
PLAY_INSTRUCTION="Leave Geralt and Groh idle on Kaer Morhen. The profiler may reduce frame rate."
TEST_ENV=( "SC6VRR_UNCAP=1" "SC6VRR_MAX_FPS=120" "SC6VRR_GATE=1" "SC6VRR_MEASURE=1" "SC6VRR_FRAME_TIMERS=0" "DXMT_LOG_FRAME_STATS=1" "METAL_PERFORMANCE_PER_FRAME_SIGNPOSTS=1" "MTL_HUD_ENCODER_TIMING_ENABLED=0" )
