# The new DXMT build with MetalFX turned off. Retina mode stays at the bottle
# default (on). Checks that the build loads, and records the cold-start PSO count.
DESCRIPTION="New DXMT, MetalFX off, Retina default"
LAUNCH=bundle
RETINA_SC6=unset
GAMEMODE=auto
TEST_ENV=( "DXMT_CONFIG=d3d11.metalSpatialUpscale=False;" )
